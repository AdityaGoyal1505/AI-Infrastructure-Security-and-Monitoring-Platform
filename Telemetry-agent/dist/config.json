{
  "backend_url": "http://127.0.0.1:8000/api/events/batch/",

  "_comment": "Need to be filled by user with actual backend URL and API key for the workspace (Remove log files or API monitors if not needed)",

  "api_key": "ac5b2164-c5a3-4ff8-8806-9621cc78807e",

  "node_id": "local-node",

  "poll_interval": 1,


  "logs": [
    {
      "path": "./logs/redis.log",
      "service": "redis"
    },
    {
      "path": "./logs/celery.log",
      "service": "celery"
    },
    {
      "path": "./logs/django.log",
      "service": "django"
    },
    {
      "path": "./logs/postgres.log",
      "service": "postgres"
    },
    {
      "path": "./logs/react.log",
      "service": "react"
    }
  ],

  "api_monitors": [
    {
      "service": "auth-api",
      "url": "http://localhost:8000/health",
      "method": "GET",
      "interval": 10,
      "timeout": 5
    },
    {
      "service": "payment-api",
      "url": "http://localhost:9000/health",
      "method": "GET",
      "interval": 15,
      "timeout": 5
    }
  ]
}